{
  "name": "asad-exe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4180",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4180",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-asad-exe 'tsx --test tests/rules.integration.ts'",
    "audit": "npm audit --omit=dev",
    "content": "tsx scripts/content.ts",
    "firebase:onboard": "tsx scripts/firebase-owner.ts",
    "test:e2e": "playwright test",
    "test:documents": "firebase emulators:exec --only auth,firestore,storage --project demo-asad-exe 'tsx --test tests/documents.integration.ts'",
    "test:content": "firebase emulators:exec --only auth,firestore --project demo-asad-exe 'tsx --test tests/content.integration.ts'"
  },
  "dependencies": {
    "file-type": "^21.0.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.17.2",
    "next": "16.4.3",
    "pixelarticons": "^2.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.34.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1",
    "@opentelemetry/core": "2.8.0"
  }
}
