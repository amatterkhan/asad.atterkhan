SITE_URL=http://127.0.0.1:4180
INDEX_SITE=false
ENABLE_DOCUMENT_ADMIN=false
ENABLE_ACHIEVEMENT_ADMIN=false
# Owner content admin: site copy and articles (/api/admin/site, /articles, /preview).
ENABLE_CONTENT_ADMIN=false
# git (default): content/ files. firestore: publicArticles, publicProjects, siteSettings/public.
CONTENT_SOURCE=git
# Optional: lets the backend or CI call POST /api/revalidate (≥ 32 chars). Admin routes revalidate directly.
# REVALIDATE_SECRET=
ENABLE_PUBLIC_FILES=false
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_OWNER_UID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Use ADC / managed service identity; never paste service-account JSON into Git.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
