# Public site URL used in canonical links, RSS, sitemap and Open Graph tags.
SITE_URL=https://asad.atterkhan.com
# true only for the production deployment; everything else is noindex.
INDEX_SITE=false
# git (default): content/ files. firestore: the snapshot written by `go run ./cmd/export` (api/).
CONTENT_SOURCE=git
# CONTENT_EXPORT_DIR=.content-export
# Owner sign-in on /admin and /calendar (Firebase web config; these are public identifiers).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Local only: point the owner sign-in at the Auth emulator.
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
# Dev server: where /api, /files and /media are proxied.
# API_ORIGIN=http://127.0.0.1:8081
